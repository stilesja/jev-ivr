# Public hostname Twilio reaches (your ngrok reserved domain), no scheme, no trailing slash
PUBLIC_HOST=your-domain.ngrok.app
# From the Twilio console; used to validate X-Twilio-Signature
TWILIO_AUTH_TOKEN=
# E.164 number dialed when the caller is handed to an agent (your cell for the demo)
HANDOFF_NUMBER=+15551234567
# stub (corpus fixture), heuristic (keyword), or jev (real model; needs TYPESAFE_API_KEY) (the regression harness also accepts record and recorded)
JEV_CLIENT=stub
TYPESAFE_API_KEY=
# Optional
PORT=3000
TRACE_DIR=traces
SIGNATURE_CHECK=on
RECONNECT_LIMIT=2
# How long an idle call session is kept, and the hard cap on any one session's lifetime
SESSION_TTL_MS=1800000
SESSION_MAX_AGE_MS=7200000
# IANA zone the caller's "today" is resolved in; defaults to the host's zone
# TIMEZONE=America/Los_Angeles
# TODAY_OVERRIDE=2026-09-18
# Recorded prompts (see README "Recorded prompts"); defaults to assets/audio
# AUDIO_DIR=assets/audio
# ConversationRelay TTS voice for the segments that are not recorded; set both or neither.
# Pick the Twilio voice closest to your recorded voice; unrecorded segments are spoken with it.
# TTS_PROVIDER is one of Google, Amazon, ElevenLabs.
# TTS_PROVIDER=ElevenLabs
# TTS_VOICE=<voice id>
# Fish Audio, for pnpm prompts:generate (clip generation; never needed by the server)
FISH_AUDIO_API_KEY=
# The voice id from its page URL (fish.audio/m/<id>/); titles are shared across the public library.
# This is Hannah by Fish Official, "A conversation specialist".
FISH_VOICE=9a9cf47702da476aa4629e2506d4a857
