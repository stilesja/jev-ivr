    "type": "choice",
  },
  "dobYear": {
    "criteria": {
      "none": "No span of asr.text is a year of the caller's birth",
    },
    "instructions": "Read asr.text. Which of these spans is the year of the caller's birth, if they say one, as in "nineteen seventy four", "seventy four", or "two thousand one"? Choose none when no year is said.",
    "type": "choice",
  },
  "frustration": {
    "instructions": "Read asr.text. How frustrated does the caller sound?",
