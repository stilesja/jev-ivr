    },
    "instructions": "Read asr.text and node.promptJustPlayed. The caller was asked whether they have the provider's name. Do they say whether they know it, without naming a provider?",
    "type": "choice",
  },
  "providerUnsure": {
    "criteria": {
      "false": "The caller names a provider plainly, or names none. A caller correcting themselves, as in Dr. Chen, not Dr. Cheng, is sure, and so is a caller who hedges only about what they want done, as in maybe cancel it with Dr. Chen",
      "true": "The caller hedges about the provider, as in it might be Dr. Kim or Dr. Rossi I think, or offers two names for one provider, as in Dr. Chen or Cheng, I am not sure",
    },
    "instructions": "Read asr.text. Is the caller unsure which provider they mean, or unsure of that provider's name?",
    "type": "noul",
  },
  "rephrasingLastTurn": {
    "instructions": "Read asr.text and history. Is the caller repeating or rewording a request because the previous turn's outcome in history shows the system did not act on it?",
    "type": "noul",
  },
  "spokeAMenuNumber": {
    "instructions": "Read asr.text. Does the caller say a single number as if choosing a menu option, such as "one" or "press two"?",
    "type": "noul",
  },
  "timeOfDay": {
    "criteria": {
      "afternoon": "Asks for the afternoon, late in the day, after work, end of day, or a time from two onward",
      "midday": "Asks for midday, noon, lunchtime, late morning, early afternoon, or a time between eleven and two",
      "morning": "Asks for the morning, first thing, early in the day, or a time before eleven",
      "none": "Says nothing about the part of the day",
    },
    "instructions": "Read asr.text. Does the caller say what part of the day they want the appointment in? Read only what they say about the time of day; a weekday or a date on its own says nothing about it, a greeting such as good morning or good afternoon says nothing about it, and earlier or later on their own, including later in the day, are not a part of the day; early next week or early this month is about the day, not the time of day.",
    "type": "choice",
  },
  "timePreference": {
    "criteria": {
      "different": "Says the offered time itself does not work, without saying which way, as in not that time, a different time, or that time is no good; the time has to be what they object to",
      "earlier": "Asks for an earlier time, or anything before the offered time, as in earlier, sooner in the day, or before that",
      "later": "Asks for a later time, or anything after the offered time, as in later, after that, or later in the day",
      "none": "Accepts, says a bare no or declines without mentioning the time, names a day or a part of the day such as the morning or the afternoon, or says nothing about the time",
    },
    "instructions": "Read asr.text and node.promptJustPlayed. The caller was offered an appointment at a specific time. Do they ask for a different time on the same day, and in which direction? A bare no, or a refusal that does not mention the time, answers the yes/no question and is none.",
    "type": "choice",
  },
  "triedSelfService": {
    "instructions": "Read asr.text. Does the caller say they already tried the website, the app, or an earlier call?",
    "type": "noul",
  },
  "urgency": {
    "instructions": "Read asr.text. How urgent is the caller's need?",
    "levels": [
      {
        "description": "No time pressure mentioned",
        "label": "low",
      },
      {
        "description": "Wants it handled soon",
        "label": "normal",
      },
      {
        "description": "Says it is urgent, an emergency, or must happen today",
        "label": "high",
      },
    ],
    "type": "score",
  },
  "utteranceComplete": {
    "instructions": "Read asr.text. Has the caller finished their thought, rather than trailing off or being cut short?",
    "type": "noul",
  },
  "wantsHuman": {
    "instructions": "Read asr.text. Does the caller explicitly ask to talk to a person, an agent, a representative, or an operator?",
    "type": "noul",
  },
}
